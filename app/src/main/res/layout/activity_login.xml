<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="#F5F7FC"
    android:padding="24dp">

    <TextView
        android:layout_width="65dp"
        android:layout_height="65dp"
        android:gravity="center"
        android:text="HH"
        android:textSize="25sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="@drawable/blue_button_bg"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Happy Happenings"
        android:textSize="25sp"
        android:textStyle="bold"
        android:textColor="#172B4D"
        android:layout_marginTop="15dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome back! Login to your account"
        android:textSize="13sp"
        android:textColor="#7B8798"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="25dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@drawable/register_card_bg">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Login"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#172B4D"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Email Address"
            android:textColor="#344054"
            android:textStyle="bold"
            android:textSize="13sp"/>

        <EditText
            android:id="@+id/email"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Enter your email"
            android:padding="14dp"
            android:textSize="14sp"
            android:inputType="textEmailAddress"
            android:background="@drawable/register_input_bg"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Password"
            android:textColor="#344054"
            android:textStyle="bold"
            android:textSize="13sp"/>

        <EditText
            android:id="@+id/password"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Enter your password"
            android:padding="14dp"
            android:textSize="14sp"
            android:inputType="textPassword"
            android:background="@drawable/register_input_bg"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="22dp"/>

        <Button
            android:id="@+id/login"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Login"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            app:backgroundTint="@null"
            android:background="@drawable/blue_button_bg"
            android:backgroundTint="@null"/>

        <TextView
            android:id="@+id/signup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Don't have an account? Sign Up"
            android:textSize="13sp"
            android:textColor="#2563EB"
            android:gravity="center"
            android:layout_marginTop="20dp"
            android:padding="8dp"/>

    </LinearLayout>

</LinearLayout>
