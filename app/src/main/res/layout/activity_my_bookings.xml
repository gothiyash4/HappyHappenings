<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FC"
    android:padding="20dp">

    <!-- Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="14dp">

        <TextView
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="←"
            android:textSize="24sp"
            android:textColor="#172B4D"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/pageTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Bookings"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#172B4D"/>

            <TextView
                android:id="@+id/pageSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="View your event booking history"
                android:textSize="13sp"
                android:textColor="#7B8798"
                android:layout_marginTop="2dp"/>

        </LinearLayout>

    </LinearLayout>

    <!-- Filter Controls Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/register_card_bg">

        <!-- Search Field (Vendor / Customer / Service Title) -->
        <EditText
            android:id="@+id/searchFilterEditText"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:hint="🔍 Search vendor, customer, or service..."
            android:padding="12dp"
            android:textSize="13sp"
            android:inputType="text"
            android:background="@drawable/register_input_bg"
            android:layout_marginBottom="10dp"/>

        <!-- Category & Status Filter Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <!-- Category Spinner -->
            <Spinner
                android:id="@+id/categoryFilterSpinner"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/register_input_bg"
                android:padding="8dp"
                android:layout_marginEnd="6dp"/>

            <!-- Status Spinner -->
            <Spinner
                android:id="@+id/statusFilterSpinner"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/register_input_bg"
                android:padding="8dp"/>

        </LinearLayout>

        <!-- Date Filter & Reset Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Date Filter Button -->
            <TextView
                android:id="@+id/dateFilterButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="📅 Date: All"
                android:textSize="12sp"
                android:textColor="#172B4D"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/register_input_bg"
                android:layout_marginEnd="6dp"/>

            <!-- Reset Filter Button -->
            <TextView
                android:id="@+id/resetFilterButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="↺ Reset"
                android:textSize="12sp"
                android:textColor="#2563EB"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/register_input_bg"/>

        </LinearLayout>

    </LinearLayout>

    <!-- Status Message -->
    <TextView
        android:id="@+id/statusTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Loading bookings..."
        android:textSize="14sp"
        android:textColor="#7B8798"
        android:gravity="center"
        android:padding="30dp"
        android:visibility="visible"/>

    <!-- Bookings Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/bookingsListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

    </ScrollView>

</LinearLayout>
