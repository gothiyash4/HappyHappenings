<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="65dp"
            android:layout_height="65dp"
            android:gravity="center"
            android:text="HH"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/blue_button_bg"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Happy Happenings"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="#172B4D"
            android:layout_marginTop="15dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create your account"
            android:textSize="14sp"
            android:textColor="#7B8798"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="25dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/register_card_bg">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sign Up"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#172B4D"
                android:layout_marginBottom="20dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Full Name"
                android:textColor="#344054"
                android:textStyle="bold"
                android:textSize="13sp"/>

            <EditText
                android:id="@+id/name"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Enter your full name"
                android:padding="14dp"
                android:textSize="14sp"
                android:inputType="textPersonName"
                android:background="@drawable/register_input_bg"
                android:layout_marginTop="7dp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email Address"
                android:textColor="#344054"
                android:textStyle="bold"
                android:textSize="13sp"/>

            <EditText
                android:id="@+id/email"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Enter your email"
                android:padding="14dp"
                android:textSize="14sp"
                android:inputType="textEmailAddress"
                android:background="@drawable/register_input_bg"
                android:layout_marginTop="7dp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Password"
                android:textColor="#344054"
                android:textStyle="bold"
                android:textSize="13sp"/>

            <EditText
                android:id="@+id/password"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Create a password"
                android:padding="14dp"
                android:textSize="14sp"
                android:inputType="textPassword"
                android:background="@drawable/register_input_bg"
                android:layout_marginTop="7dp"
                android:layout_marginBottom="20dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Register As"
                android:textColor="#344054"
                android:textStyle="bold"
                android:textSize="13sp"/>

            <RadioGroup
                android:id="@+id/roleGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="15dp">

                <RadioButton
                    android:id="@+id/user"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="User"
                    android:textColor="#344054"
                    android:checked="true"
                    android:buttonTint="#2563EB"/>

                <RadioButton
                    android:id="@+id/vendor"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Vendor"
                    android:textColor="#344054"
                    android:buttonTint="#2563EB"/>

            </RadioGroup>

            <LinearLayout
                android:id="@+id/vendorCategoryLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select Vendor Category"
                    android:textColor="#344054"
                    android:textStyle="bold"
                    android:textSize="13sp"/>

                <Spinner
                    android:id="@+id/vendorCategory"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/register_input_bg"
                    android:padding="10dp"
                    android:layout_marginTop="7dp"/>

            </LinearLayout>

            <Button
                android:id="@+id/register"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Create Account"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                app:backgroundTint="@null"
                android:background="@drawable/blue_button_bg"
                android:backgroundTint="@null"/>

            <TextView
                android:id="@+id/loginLink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Already have an account? Log In"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#2563EB"
                android:gravity="center"
                android:padding="10dp"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="By creating an account, you agree to our Terms &amp; Privacy Policy."
                android:textSize="11sp"
                android:textColor="#8993A4"
                android:gravity="center"
                android:layout_marginTop="12dp"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
